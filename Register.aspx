<style>
:root{
  --navy:#133a7d; --navy-2:#1b4ea6; --navy-ink:#0d2a5e;
  --orange:#f58220; --orange-d:#e2761a;
  --green:#14874a; --green-soft:#e7f6ed;
  --ink:#16213a; --muted:#5b6880; --line:#e3e8f0;
  --bg:#f4f7fc; --card:#fff;
  --shadow:0 10px 30px rgba(16,38,80,.09);
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  font-family:'Plus Jakarta Sans',system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;
  color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased;
  font-size:16px;line-height:1.55;
}
img,svg{max-width:100%;display:block}
a{color:var(--navy-2);text-decoration:none}
a:hover{text-decoration:underline}

/* ---------- slim brand strip (site header & footer intentionally omitted) ---------- */
.rg-strip{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}
.rg-strip-in{max-width:1180px;margin:0 auto;padding:10px 18px;display:flex;align-items:center;justify-content:space-between;gap:12px}
.rg-brand{display:flex;align-items:center;gap:10px;color:var(--navy-ink)}
.rg-logo{height:46px;width:auto;max-width:230px}
.rg-strip-act{display:flex;align-items:center;gap:10px;font-size:13.5px;color:var(--muted);font-weight:600}
.rg-strip-act .lbl{display:none}
.rg-login{border:1.5px solid var(--navy-2);color:var(--navy-2);border-radius:10px;padding:8px 16px;font-weight:700;font-size:14px;white-space:nowrap}
.rg-login:hover{background:var(--navy-2);color:#fff;text-decoration:none}

/* ---------- layout ---------- */
.rg-wrap{max-width:1180px;margin:0 auto;padding:22px 18px 10px}
.rg-grid{display:grid;grid-template-columns:1fr;gap:22px;align-items:start}
/* mobile-first: registration card above the content */
.rg-right{order:-1}
.rg-left{order:1}

/* ---------- left ---------- */
.rg-pill{display:inline-flex;align-items:center;gap:7px;background:#e8efff;color:var(--navy-2);
  font-size:11.5px;font-weight:800;letter-spacing:1px;text-transform:uppercase;padding:6px 12px;border-radius:999px;margin-bottom:12px}
.rg-pill i{width:7px;height:7px;border-radius:50%;background:var(--green);display:block}
h1{font-size:clamp(26px,5.4vw,40px);line-height:1.14;margin:0 0 10px;font-weight:800;letter-spacing:-.7px;color:var(--navy-ink)}
h1 em{font-style:normal;color:var(--orange)}
.rg-lede{margin:0 0 20px;color:var(--muted);font-size:15.5px;font-weight:600;max-width:54ch}
.rg-lede b{color:#3a4760;font-weight:700}

.rg-cards{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:0 0 16px}
.rg-c{background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px 12px 15px;text-align:center;
  box-shadow:0 2px 12px rgba(16,38,80,.05)}
.rg-c .blob{width:78px;height:78px;margin:0 auto 10px;border-radius:50%;display:grid;place-items:center}
.rg-c .blob.b1{background:#e9f0ff}.rg-c .blob.b2{background:#fdf0e6}
.rg-c .blob.b3{background:#f2edfd}.rg-c .blob.b4{background:#e8f6ee}
.rg-c h3{margin:0 0 4px;font-size:15px;font-weight:800;color:var(--navy-ink);letter-spacing:-.2px}
.rg-c p{margin:0;font-size:12.5px;color:var(--muted);line-height:1.45}
.rg-c .join{display:inline-block;background:var(--green-soft);color:#0f6b3c;font-weight:800;font-size:13px;
  padding:3px 12px;border-radius:999px;margin-bottom:3px}

.rg-plans{display:flex;align-items:stretch;gap:10px;background:#fff;border:1px solid var(--line);
  border-radius:16px;padding:10px;margin:0 0 16px;box-shadow:0 2px 12px rgba(16,38,80,.05);flex-wrap:wrap}
.rg-plan-tag{background:var(--navy-2);color:#fff;border-radius:12px;padding:12px 16px;display:flex;align-items:center;gap:9px;
  font-weight:800;font-size:15px;line-height:1.1;flex:1 1 100%;justify-content:center}
.rg-chip{flex:1 1 0;min-width:142px;border-radius:12px;padding:12px 10px;display:flex;align-items:center;
  justify-content:center;gap:7px;text-align:center;font-size:13.5px;font-weight:700;line-height:1.3}
.rg-chip.c1{background:#e8f6ee;color:#0f6b3c}
.rg-chip.c2{background:#eaf1fe;color:#17407f}
.rg-chip svg{flex:0 0 17px}

.rg-steps{background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px;margin-bottom:18px;
  box-shadow:0 2px 12px rgba(16,38,80,.05)}
.rg-steps h2{font-size:12px;text-transform:uppercase;letter-spacing:1.1px;color:var(--muted);margin:0 0 14px;font-weight:800}
.rg-step-row{display:grid;grid-template-columns:1fr;gap:12px;position:relative}
.rg-step{display:flex;gap:11px;align-items:flex-start}
.rg-step .n{width:30px;height:30px;flex:0 0 30px;border-radius:50%;background:var(--navy-2);color:#fff;
  font-weight:800;font-size:14px;display:grid;place-items:center}
.rg-step:nth-child(2) .n{background:var(--orange)}
.rg-step:nth-child(3) .n{background:var(--green)}
.rg-step b{display:block;font-size:14px}
.rg-step small{display:block;font-size:12.5px;color:var(--muted)}

/* ---------- right : form ---------- */
.rg-card{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:22px;box-shadow:var(--shadow)}
.rg-card h2.t{font-size:21px;margin:0 0 4px;font-weight:800;color:var(--navy-ink);letter-spacing:-.3px}
.rg-card .sub{margin:0 0 18px;font-size:14px;color:var(--muted)}
.rg-free{display:inline-flex;align-items:center;gap:6px;background:var(--green-soft);color:#0f6b3c;
  font-size:12px;font-weight:800;padding:5px 10px;border-radius:999px;margin-bottom:12px}
.fld{margin-bottom:14px}
.fld label{display:block;font-size:13px;font-weight:700;color:#2c3650;margin-bottom:6px}
.inp-wrap{position:relative;display:flex;align-items:center}
.inp-wrap .pre{position:absolute;left:1px;top:1px;bottom:1px;width:50px;display:grid;place-items:center;
  font-size:14px;font-weight:700;color:var(--muted);border-right:1px solid var(--line);background:#f7f9fd;
  border-radius:11px 0 0 11px;pointer-events:none;z-index:1}
.cae-input{width:100%;height:50px;border:1.5px solid #dbe2ee;border-radius:12px;padding:0 14px;font-size:15px;
  font-family:inherit;color:var(--ink);background:#fff;transition:border-color .15s,box-shadow .15s}
.cae-input::placeholder{color:#9aa6bb}
.cae-input:focus{outline:none;border-color:var(--navy-2);box-shadow:0 0 0 3.5px rgba(27,78,166,.13)}
.has-pre .cae-input{padding-left:62px}
.eye{position:absolute;right:8px;width:36px;height:36px;border:0;background:transparent;color:#8b97ad;
  border-radius:8px;display:grid;place-items:center;cursor:pointer}
.eye:hover{background:#f1f4fa;color:var(--navy-2)}
.vmsg{display:block;font-size:12.5px;color:#d12b2b;margin-top:5px;font-weight:600}

.cap{border:1px dashed #cfd9e8;background:#fafcff;border-radius:14px;padding:14px;margin:4px 0 16px;text-align:center}
.cap-ttl{font-size:12.5px;font-weight:700;color:var(--muted);margin-bottom:10px}
.cap-row{display:flex;align-items:center;justify-content:center;gap:8px;flex-wrap:wrap}
.cap-img{height:50px;width:150px;border:1px solid var(--line);border-radius:10px;background:#fff;object-fit:contain}
.cap-refresh{width:42px;height:42px;border:1.5px solid #dbe2ee;background:#fff;border-radius:10px;color:var(--navy-2);
  display:grid;place-items:center;cursor:pointer}
.cap-refresh:hover{background:#eef3fc}
.cap-in{display:flex;justify-content:center;margin-top:12px}
.cap-in .cae-input{max-width:170px;text-align:center;letter-spacing:3px;font-weight:700;text-transform:uppercase}
.cae-result{display:block;font-size:12.5px;font-weight:600;margin-top:6px}

.agree{display:flex;gap:10px;align-items:flex-start;font-size:13px;color:var(--muted);margin-bottom:16px}
.agree input{width:18px;height:18px;margin-top:2px;accent-color:var(--navy-2);flex:0 0 18px}
.cae-btn{width:100%;height:54px;border:0;border-radius:13px;cursor:pointer;background:linear-gradient(180deg,#f29330,#e2761a);
  color:#fff;font-family:inherit;font-size:16.5px;font-weight:800;letter-spacing:.2px;
  box-shadow:0 8px 18px rgba(226,118,26,.28);transition:transform .08s,box-shadow .15s}
.cae-btn:hover{box-shadow:0 10px 22px rgba(226,118,26,.36)}
.cae-btn:active{transform:translateY(1px)}
.card-foot{text-align:center;font-size:13.5px;color:var(--muted);margin-top:14px}
.safe{display:flex;gap:10px;align-items:flex-start;background:var(--green-soft);border-radius:12px;padding:11px 12px;
  margin-top:14px;font-size:12.5px;color:#14603a}
.safe svg{flex:0 0 18px;margin-top:1px}

/* ---------- disclaimer ---------- */
.rg-note{max-width:1180px;margin:18px auto 0;padding:14px 18px 40px;display:flex;gap:10px;align-items:flex-start;
  font-size:12.5px;color:var(--muted)}
.rg-note .i{width:20px;height:20px;flex:0 0 20px;border-radius:50%;background:#dfe6f3;color:var(--navy-2);
  display:grid;place-items:center;font-weight:800;font-size:12px;font-style:normal}
.rg-note p{margin:0;max-width:92ch}

/* ---------- desktop ---------- */
@media (min-width:900px){
  .rg-wrap{padding:34px 24px 10px}
  .rg-grid{grid-template-columns:1.1fr .9fr;gap:38px}
  .rg-right{position:sticky;top:76px;order:0}
  .rg-left{order:0}
  .rg-card{padding:26px}
  .rg-strip-act .lbl{display:inline}
  .rg-logo{height:54px;max-width:260px}
  .rg-plan-tag{flex:0 0 auto}
  .rg-step-row{grid-template-columns:repeat(3,1fr);gap:14px}
  .rg-step{flex-direction:column;gap:8px}
  .rg-step-row:before{content:"";position:absolute;top:15px;left:16%;right:16%;border-top:2px dashed #d6e0f1;z-index:0}
  .rg-step .n{position:relative;z-index:1;box-shadow:0 0 0 5px #fff}
}
@media (min-width:1150px){
  .rg-cards{grid-template-columns:repeat(4,1fr);gap:10px}
  .rg-c{padding:14px 8px}
  .rg-c .blob{width:68px;height:68px}
  .rg-c h3{font-size:13.5px}
  .rg-c p{font-size:11.5px}
}
@media (max-width:899px){
  .rg-card{border-radius:16px;padding:18px}
  h1{letter-spacing:-.3px}
  .rg-c .blob{width:66px;height:66px}
  .rg-c h3{font-size:14px}
}
@media (max-width:359px){ .rg-cards{grid-template-columns:1fr} }
</style>
</head>

<body>
<form id="form1" runat="server">

<div class="rg-strip">
  <div class="rg-strip-in">
    <a class="rg-brand" href="https://www.clearallexams.in/">
        <img class="rg-logo" src="/images/new-logo.png" alt="ClearAllExams.in &#183; Smart NISM Preparation Starts Here" />
      </a>
    <div class="rg-strip-act">
      <span class="lbl">Already registered?</span>
      <a class="rg-login" href="/login">Login</a>
    </div>
  </div>
</div>

<main class="rg-wrap">
  <div class="rg-grid">

    <!-- ===================== LEFT ===================== -->
    <section class="rg-left">
      <span class="rg-pill"><i></i> NISM Exam Preparation</span>
      <h1>Prepare for <em>NISM Exams</em> with trusted study resources</h1>
      <p class="rg-lede"><b>Exam-Pattern Questions &#183; Detailed Solutions &#183; Revision Notes &#183; Better Preparation</b></p>

      <div class="rg-cards">

        <article class="rg-c">
          <div class="blob b1">
            <svg width="46" height="46" viewBox="0 0 64 64" aria-hidden="true">
              <rect x="12" y="10" width="40" height="46" rx="6" fill="#fff" stroke="#1b4ea6" stroke-width="3.2"/>
              <rect x="24" y="5" width="16" height="10" rx="3" fill="#1b4ea6"/>
              <circle cx="32" cy="7.5" r="2.6" fill="#fff"/>
              <circle cx="24" cy="26" r="4.6" fill="#1aa85a"/><path d="m22 26 1.6 1.7 3-3.3" stroke="#fff" stroke-width="1.9" fill="none" stroke-linecap="round"/>
              <rect x="32" y="23.4" width="14" height="2.6" rx="1.3" fill="#9dbbe8"/><rect x="32" y="28" width="10" height="2.6" rx="1.3" fill="#cfe0f6"/>
              <circle cx="24" cy="38" r="4.6" fill="#1aa85a"/><path d="m22 38 1.6 1.7 3-3.3" stroke="#fff" stroke-width="1.9" fill="none" stroke-linecap="round"/>
              <rect x="32" y="35.4" width="14" height="2.6" rx="1.3" fill="#9dbbe8"/><rect x="32" y="40" width="10" height="2.6" rx="1.3" fill="#cfe0f6"/>
              <circle cx="24" cy="50" r="4.6" fill="#1aa85a"/><path d="m22 50 1.6 1.7 3-3.3" stroke="#fff" stroke-width="1.9" fill="none" stroke-linecap="round"/>
              <rect x="32" y="47.4" width="14" height="2.6" rx="1.3" fill="#9dbbe8"/>
            </svg>
          </div>
          <h3>Latest Mock Tests</h3>
          <p>Exam-pattern questions with detailed explanations</p>
        </article>

        <article class="rg-c">
          <div class="blob b2">
            <svg width="46" height="46" viewBox="0 0 24 24" aria-hidden="true">
              <g fill="none" stroke="#f58220" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/>
                <path d="M21 3v5h-5"/>
              </g>
              <text x="12" y="15.2" text-anchor="middle" font-family="'Plus Jakarta Sans',sans-serif" font-size="8.6" font-weight="800" fill="#0d2a5e">15</text>
            </svg>
          </div>
          <h3>15 Attempts Each</h3>
          <p>Repeat every mock test up to 15 times</p>
        </article>

        <article class="rg-c">
          <div class="blob b3">
            <svg width="46" height="46" viewBox="0 0 64 64" aria-hidden="true">
              <rect x="18" y="6" width="36" height="44" rx="6" fill="#8b6fe0" transform="rotate(8 36 28)"/>
              <rect x="12" y="10" width="36" height="44" rx="6" fill="#fff" stroke="#8b6fe0" stroke-width="3" transform="rotate(-5 30 32)"/>
