            </svg>
          </div>
          <h3>Short Notes</h3>
          <p>Quick, concise revision for faster preparation</p>
        </article>

        <article class="rg-c">
          <div class="blob b4">
            <svg width="46" height="46" viewBox="0 0 64 64" aria-hidden="true">
              <circle cx="30" cy="34" r="22" fill="#f58220"/>
              <circle cx="30" cy="34" r="15.5" fill="#fff"/>
              <circle cx="30" cy="34" r="10" fill="#f58220"/>
              <circle cx="30" cy="34" r="4.4" fill="#fff"/>
