              <path d="M44 10h10v10" fill="none" stroke="#153a7d" stroke-width="4.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3>Proven Results</h3>
          <span class="join">Join 10,000+</span>
          <p>successful candidates</p>
        </article>

      </div>

      <div class="rg-plans">
        <div class="rg-plan-tag">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 3 5 6v6c0 4.2 2.8 7.2 7 9 4.2-1.8 7-4.8 7-9V6l-7-3Z"/><path d="m8.8 12 2.2 2.2 4.4-4.8"/>
