          Free Demo
        </div>
        <div class="rg-chip c1">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
          No payment needed
        </div>
        <div class="rg-chip c2">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" aria-hidden="true"><path d="M13 2 4.5 13H11l-1 9 9-11.5H12.5L13 2Z"/></svg>
          Instant access after sign-up
        </div>
      </div>

      <div class="rg-steps">
        <h2>How it works</h2>
        <div class="rg-step-row">
          <div class="rg-step"><span class="n">1</span><span><b>Create free account</b><small>Takes about 30 seconds</small></span></div>
          <div class="rg-step"><span class="n">2</span><span><b>Attempt free mock test</b><small>Real exam pattern &amp; timer</small></span></div>
          <div class="rg-step"><span class="n">3</span><span><b>See score &amp; explanations</b><small>Fix weak chapters, then clear</small></span></div>
        </div>
      </div>
    </section>

    <!-- ===================== RIGHT : FORM ===================== -->
    <aside class="rg-right">
      <section class="rg-card">
        <span class="rg-free">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
          100% free to start
        </span>
        <h2 class="t">Create your free account</h2>
        <p class="sub">Register once and start your NISM mock test right away.</p>

        <div class="fld">
          <label for="<%= txtFullName.ClientID %>">Name</label>
          <div class="inp-wrap">
            <asp:TextBox ID="txtFullName" runat="server" CssClass="cae-input" MaxLength="60"
              placeholder="Enter your name" autocomplete="name" />
          </div>
          <asp:RequiredFieldValidator ID="RequiredFieldValidator2" runat="server" ControlToValidate="txtFullName"
            ValidationGroup="ram" Display="Dynamic" CssClass="vmsg" ErrorMessage="Please enter your name." />
        </div>

        <div class="fld">
          <label for="<%= txtContactNo.ClientID %>">Mobile number</label>
          <div class="inp-wrap has-pre">
            <span class="pre">+91</span>
            <asp:TextBox ID="txtContactNo" runat="server" CssClass="cae-input" TextMode="Phone" MaxLength="10"
              placeholder="10-digit mobile number" autocomplete="tel-national" inputmode="numeric" />
          </div>
          <asp:RequiredFieldValidator ID="RequiredFieldValidator5" runat="server" ControlToValidate="txtContactNo"
            ValidationGroup="ram" Display="Dynamic" CssClass="vmsg" ErrorMessage="Please enter your mobile number." />
          <asp:RegularExpressionValidator ID="revContactNumber" runat="server" ControlToValidate="txtContactNo"
            ValidationGroup="ram" Display="Dynamic" CssClass="vmsg" ValidationExpression="^[6-9]\d{9}$"
            ErrorMessage="Enter a valid 10-digit mobile number." />
        </div>

        <div class="fld">
          <label for="<%= txtEmail.ClientID %>">Email address</label>
          <div class="inp-wrap">
            <asp:TextBox ID="txtEmail" runat="server" CssClass="cae-input" TextMode="Email" MaxLength="80"
              placeholder="you@example.com" autocomplete="email" />
          </div>
          <asp:RequiredFieldValidator ID="RequiredFieldValidator4" runat="server" ControlToValidate="txtEmail"
            ValidationGroup="ram" Display="Dynamic" CssClass="vmsg" ErrorMessage="Please enter your email address." />
          <asp:RegularExpressionValidator ID="revEmail" runat="server" ControlToValidate="txtEmail"
            ValidationGroup="ram" Display="Dynamic" CssClass="vmsg" ValidationExpression="^[^@\s]+@[^@\s]+\.[^@\s]+$"
            ErrorMessage="Enter a valid email address." />
        </div>

        <div class="fld">
          <label for="<%= txtpwd.ClientID %>">Create password</label>
          <div class="inp-wrap">
            <asp:TextBox ID="txtpwd" runat="server" CssClass="cae-input" TextMode="Password" MaxLength="40"
              placeholder="Enter a password" autocomplete="new-password" />
            <button type="button" class="eye" id="btnEye" aria-label="Show password"
              onclick="caeTogglePassword('<%= txtpwd.ClientID %>', this);">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2 12s4-6.5 10-6.5S22 12 22 12s-4 6.5-10 6.5S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
          <asp:RequiredFieldValidator ID="RequiredFieldValidator7" runat="server" ControlToValidate="txtpwd"
            ValidationGroup="ram" Display="Dynamic" CssClass="vmsg" ErrorMessage="Please create a password." />
        </div>

        <div class="cap">
          <div class="cap-ttl">Enter the code shown below</div>
          <div class="cap-row">
            <asp:Image ID="imgCaptcha" runat="server" CssClass="cap-img" ImageUrl="~/Captcha.aspx" AlternateText="Captcha code" />
            <button type="button" class="cap-refresh" aria-label="Refresh captcha"
              onclick="caeRefreshCaptcha('<%= imgCaptcha.ClientID %>');">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></svg>
            </button>
          </div>
          <div class="cap-in">
            <asp:TextBox ID="txtCaptcha" runat="server" CssClass="cae-input" MaxLength="6"
              placeholder="Code" autocomplete="off" />
          </div>
          <asp:RequiredFieldValidator ID="rfvCaptcha" runat="server" ControlToValidate="txtCaptcha"
            ValidationGroup="ram" Display="Dynamic" CssClass="vmsg" ErrorMessage="Please enter the code." />
          <asp:Label ID="lblResult" runat="server" ForeColor="Red" CssClass="cae-result" />
        </div>

        <label class="agree">
          <input type="checkbox" id="chkAgree" checked="checked" />
          <span>I agree to the <a href="/nism-exams-mock-test-terms-and-conditions">Terms &amp; Conditions</a> and <a href="/nism-exams-mock-test-privacy-policy">Privacy Policy</a>.</span>
        </label>

        <asp:Button ID="btnRegister" runat="server" CssClass="cae-btn" ValidationGroup="ram"
          Text="START FREE MOCK TEST →" OnClientClick="return caeAgreeCheck();" OnClick="btnRegister_Click" />

        <p class="card-foot">Already have an account? <a href="/login"><b>Login</b></a></p>

        <div class="safe">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 5 6v6c0 4.2 2.8 7.2 7 9 4.2-1.8 7-4.8 7-9V6l-7-3Z" fill="#b7ebc8" stroke="#14874a" stroke-width="1.4"/><path d="m8.6 12 2.2 2.2 4.7-5" stroke="#14874a" stroke-width="1.7" fill="none" stroke-linecap="round"/></svg>
          <span><b>Your data stays private.</b> We never sell, rent or share your personal information with any third party.</span>
        </div>
      </section>
    </aside>

  </div>
</main>

<div class="rg-note">
  <i class="i">i</i>
  <p><b>Independent NISM exam preparation platform.</b> Clear All Exams is not affiliated with, endorsed by or associated with NISM or SEBI. We are an independent platform for NISM exam preparation.</p>
</div>

  <%-- ==========================================================================
       Legacy controls kept ONLY so the existing Register.aspx.cs keeps working.
       Visible="false" => they are instantiated on the server but render NOTHING
       to the browser (no markup, no extra Captcha.aspx request).
       Delete this block once the code-behind no longer references them.
  ========================================================================== --%>
  <asp:Panel ID="pnlLegacy" runat="server" Visible="false">
    <asp:DropDownList ID="ddlTitle" runat="server" AppendDataBoundItems="True">
      <asp:ListItem Value="">Select Title</asp:ListItem>
      <asp:ListItem Value="1">Mr.</asp:ListItem>
      <asp:ListItem Value="2">Ms.</asp:ListItem>
    </asp:DropDownList>
    <asp:DropDownList ID="ddlState" runat="server" AppendDataBoundItems="True">
      <asp:ListItem Value="">Select State</asp:ListItem>
    </asp:DropDownList>
    <asp:TextBox ID="txtcity" runat="server" />
    <asp:TextBox ID="txtReemailid" runat="server" />
    <asp:CompareValidator ID="CompareValidator1" runat="server" Enabled="false"
      ControlToCompare="txtEmail" ControlToValidate="txtReemailid" ValidationGroup="ram"
      Text="*" ErrorMessage="Email ID &amp; Re-enter Email ID Mismatch" />
    <asp:TextBox ID="txtemailid" runat="server" />
    <asp:TextBox ID="txtpassword" runat="server" TextMode="Password" />
    <asp:RequiredFieldValidator ID="RequiredFieldValidator8" runat="server" Enabled="false"
      ControlToValidate="txtemailid" ValidationGroup="loginGroup" ErrorMessage="Enter your email address">*</asp:RequiredFieldValidator>
    <asp:RequiredFieldValidator ID="RequiredFieldValidator9" runat="server" Enabled="false"
      ControlToValidate="txtpassword" ValidationGroup="loginGroup" ErrorMessage="Enter your password">*</asp:RequiredFieldValidator>
    <asp:ValidationSummary ID="ValidationSummary1" runat="server" ShowMessageBox="False"
      ShowSummary="False" ValidationGroup="ram" />
    <asp:Button ID="Button1" runat="server" ValidationGroup="loginGroup" Text="Login" OnClick="Button1_Click" />
    <asp:Image ID="Image1" runat="server" ImageUrl="~/Captcha.aspx" AlternateText="" />
    <asp:TextBox ID="TextBox1" runat="server" />
    <asp:Label ID="Label1" runat="server" ForeColor="Red" />
  </asp:Panel>

</form>

<script>
function caeTogglePassword(id, btn) {
  var input = document.getElementById(id);
  if (!input) return;
  var show = input.type === "password";
  input.type = show ? "text" : "password";
  btn.setAttribute("aria-label", show ? "Hide password" : "Show password");
}

function caeRefreshCaptcha(id) {
  var img = document.getElementById(id);
  if (img) img.src = "/Captcha.aspx?t=" + new Date().getTime();
}

function caeAgreeCheck() {
  var chk = document.getElementById("chkAgree");
  if (chk && !chk.checked) {
    chk.focus();
    return false;
  }
  return true;
}

(function () {
  var mob = document.getElementById("<%= txtContactNo.ClientID %>");
  if (mob) {
    mob.addEventListener("input", function () {
      this.value = this.value.replace(/\D/g, "").slice(0, 10);
    });
  }
})();
</script>

</body>
</html>

