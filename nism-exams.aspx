        {
          "@type": "Question",
          "name": "Can I use electronic items like a calculator during the exam?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, calculators are permitted during the exam. However, no other electronic devices such as mobile phones, smartwatches, or tablets are allowed. Exam Regulations & Candidate Instructions: All candidates must follow the proctor/invigilator instructions. Unfair practices (cheating, communication, impersonation) will result in disqualification and ban. Carry a valid photo ID (Aadhaar, PAN, Passport). Entry will be denied without it. Special accommodations are available on advance request with documentation."
          }
        },
        {
          "@type": "Question",
          "name": "What happens if I fail the NISM exam? Is there a refund policy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No refund is given if you fail. You will need to re-register and repay the exam fee. Exceptions: If NISM cancels your exam, a full refund is processed automatically. Rescheduling & Re-evaluation: You may reschedule before the exam (charges may apply). Check policy here. No re-evaluation is allowed. For technical issues, contact NISM support. Data Privacy: All personal data is protected under NISM’s Privacy Policy. Tip: Always review the official exam handbook before test day."
          }
        },
        {
          "@type": "Question",
          "name": "How can I pay the NISM certification fees?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fees can be paid via credit card, debit card, or net banking through the official NISM portal during the exam booking process. Refunds are only applicable if NISM cancels the exam."
          }
        },
        {
          "@type": "Question",
          "name": "Is the NISM Exam available in Hindi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — currently only the NISM-Series-V-A: Mutual Fund Distributors exam is available in Hindi. Other modules are in English."
          }
        },
        {
          "@type": "Question",
          "name": "What is the benefit of the NISM certificate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "NISM certification is mandatory for roles like mutual fund distributors and investment advisors. For example, the Series-V-A certification is required to get an ARN number from AMFI, enabling mutual fund distribution."
          }
        }
