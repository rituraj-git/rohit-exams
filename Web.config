    <!-- ======================================================= -->
    <!-- URL REWRITE / SEO CANONICALIZATION                      -->
    <!-- ======================================================= -->

    <rewrite>

      <rules>

        <!-- =================================================== -->
        <!-- Remove Plesk duplicate SSL rule                     -->
        <!-- =================================================== -->

        <remove name="Plesk. SSL redirect for #8" />


        <!-- =================================================== -->
        <!-- 1. ROOT MULTIPLE SLASH NORMALIZATION                -->
        <!--                                                     -->
        <!-- https://www.clearallexams.in//                    -->
        <!-- https://www.clearallexams.in///                   -->
        <!-- https://www.clearallexams.in////                  -->
        <!--                                                     -->
        <!-- ALL become:                                        -->
        <!-- https://www.clearallexams.in/                      -->
        <!-- =================================================== -->

        <rule
          name="Redirect multiple root slashes"
          stopProcessing="true">

          <match url=".*" />

          <conditions>

            <add
              input="{REQUEST_URI}"
              pattern="^/{2,}$"
              ignoreCase="true" />

          </conditions>

          <action
            type="Redirect"
            url="https://www.clearallexams.in/"
            redirectType="Permanent"
            appendQueryString="true" />

        </rule>


        <!-- =================================================== -->
        <!-- 2. INDEX.ASPX -> ROOT                               -->
        <!--                                                     -->
        <!-- /Index.aspx                                        -->
        <!-- /index.aspx                                        -->
        <!-- /Index.aspx/                                       -->
        <!--                                                     -->
        <!-- becomes:                                           -->
        <!-- /                                                   -->
        <!-- =================================================== -->

        <rule
          name="Redirect Index.aspx to Root"
          stopProcessing="true">

          <match
            url="^Index\.aspx(?:/+)?$"
            ignoreCase="true" />

          <action
            type="Redirect"
            url="/"
            redirectType="Permanent"
            appendQueryString="true" />

        </rule>


        <!-- =================================================== -->
        <!-- 3. REMOVE TRAILING SLASH FROM NON-ROOT URLS        -->
        <!--                                                     -->
        <!-- /about-us/                                         -->
        <!-- /about-us//                                        -->
        <!--                                                     -->
        <!-- becomes:                                           -->
        <!-- /about-us                                          -->
        <!-- =================================================== -->

        <rule
          name="Remove trailing slash"
          stopProcessing="true">

          <match
            url="^(.+)/+$"
            ignoreCase="true" />

          <action
            type="Redirect"
            url="/{R:1}"
            redirectType="Permanent"
            appendQueryString="true" />

        </rule>


        <!-- =================================================== -->
        <!-- 4. HTTP -> HTTPS + WWW                              -->
        <!-- =================================================== -->

        <rule
          name="Plesk. SSL redirect for #8"
          enabled="true"
          patternSyntax="Wildcard"
          stopProcessing="true">

          <match url="*" />

          <conditions>

            <add
              input="{HTTPS}"
              matchType="Pattern"
              pattern="OFF"
              ignoreCase="true"
              negate="false" />

            <add
              input="{HTTP_IS_SITEPREVIEW}"
              matchType="Pattern"
              pattern="1"
              ignoreCase="true"
              negate="true" />

          </conditions>

          <serverVariables />

          <action
            type="Redirect"
            url="https://www.clearallexams.in/{R:1}"
            redirectType="Permanent"
            appendQueryString="true" />

        </rule>


        <!-- =================================================== -->
        <!-- 5. NON-WWW -> WWW                                   -->
        <!--                                                     -->
        <!-- clearallexams.in                                   -->
        <!--                                                     -->
        <!-- becomes:                                           -->
        <!-- www.clearallexams.in                               -->
        <!-- =================================================== -->

        <rule
          name="www fixer"
          stopProcessing="true">

          <match url=".*$" />

          <conditions logicalGrouping="MatchAll">

            <add
              input="{HTTP_HOST}"
              pattern="^www\.clearallexams\.in$"
              negate="true" />

            <add
              input="{HTTP_HOST}"
              pattern="^dev"
              negate="true" />

          </conditions>

          <action
            type="Redirect"
            url="https://www.clearallexams.in/{R:0}"
            appendQueryString="true"
            redirectType="Permanent" />

        </rule>


        <!-- =================================================== -->
        <!-- STATIC PAGES                                        -->
        <!-- =================================================== -->


        <!-- FAQ -->

        <rule
          name="Redirect FAQ"
          stopProcessing="true">

          <match
            url="^(faq|faq\.aspx)$"
            ignoreCase="true" />

          <action
            type="Redirect"
            url="/nism-exams-mock-test-faqs"
            redirectType="Permanent"
            appendQueryString="true" />

        </rule>


        <!-- ABOUT US -->

        <rule
