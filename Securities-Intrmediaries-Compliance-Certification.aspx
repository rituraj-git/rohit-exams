<!-- COUNTER SCRIPT -->
<script>
function animateCounter(id, end, duration) {
  let start = 0;
  let increment = end / (duration / 20);
  let counter = document.getElementById(id);

  let timer = setInterval(function () {
    start += increment;
    if (start >= end) {
      counter.innerHTML = (id === "count1") ? end + "+" : end;
      clearInterval(timer);
    } else {
      counter.innerHTML = Math.floor(start);
    }
  }, 20);
}

// RUN COUNTERS
animateCounter("count1", 1500, 1000);
animateCounter("count2", 120, 1000);
animateCounter("count3", 100, 1000);
animateCounter("count4", 100, 1000);
animateCounter("count5", 60, 1000);
animateCounter("count7", 25, 1000); // NEW
animateCounter("count6", 3, 1000);
</script>

