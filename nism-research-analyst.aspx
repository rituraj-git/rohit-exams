    </div>
    
    <!-- Right Content -->
    <div class="col-md-7 p-4">
      <h3 style="color: #0d47a1; font-weight: bold;">NISM Series-XV: Research Analyst Certification</h3>
      <p style="margin-bottom: 15px; font-size: 16px;"><strong>Course Duration:</strong> 20–25 hours</p>

      <!-- Price -->
      <div style="background-color: #0d47a1; color: #fff; font-size: 28px; font-weight: bold; padding: 10px; text-align: center; border-radius: 6px; margin-bottom: 20px;">
        Course Fee - ₹25,000 - 30,000
      </div>

      <!-- Features -->
      <ul style="list-style: none; padding: 0; font-size: 15px; color: #000;">
        <li style="border-bottom: 1px dotted #1976d2; padding: 8px 0;">
          <i class="fas fa-check-circle" style="color: #1976d2; margin-right: 8px;"></i>
          <strong>Mode:</strong> 100% Live Online Classes
        </li>
        <li style="border-bottom: 1px dotted #1976d2; padding: 8px 0;">
          <i class="fas fa-check-circle" style="color: #1976d2; margin-right: 8px;"></i>
          <strong>Faculty:</strong> Industry Experts with 10+ years of experience
        </li>
        <li style="border-bottom: 1px dotted #1976d2; padding: 8px 0;">
          <i class="fas fa-check-circle" style="color: #1976d2; margin-right: 8px;"></i>
          <strong>Session Type:</strong> Case studies + Q&A Live Discussion
