    <script>
        //Close function (must be global since used in HTML onclick)
        function closePopup() {
            $('#overlay, #exitPopup').fadeOut();
        }

        $(function () {
            const $overlay = $('#overlay');
            const $popup = $('#exitPopup');
            const $form = $('#exitForm');
            const $message = $('#message');
            let popupShown = false;

            // 🔹 Open popup on button click
            $(document).on('click', '.openPopupBtn', function () {
                $overlay.fadeIn();
                $popup.fadeIn();
                popupShown = true;
            });

            // 🔹 Close popup
            function closePopup() {
                $overlay.fadeOut();
                $popup.fadeOut();
            }

            // 🔹 Close when clicking outside
            $overlay.on('click', closePopup);

            // 🔹 Submit form
            $form.on('click', function (event) {
                event.preventDefault();

                const formData = {
                    firstName: $('#firstName').val().trim(),
                    lastName: $('#lastName').val().trim(),
                    email: $('#email').val().trim(),
                    phone: $('#phone').val().trim(),
                    city: $('#city').val().trim()
                };

                const { email, phone } = validateEmailAndPhone(formData.email, formData.phone);

                if (Object.values(formData).some(v => !v)) {
                    return showMessage('Please fill out all fields.', 'red');
                }

                if (!email) return showMessage('Invalid email address.', 'red');
                if (!phone) return showMessage('Phone number must be exactly 10 digits.', 'red');

                $.ajax({
                    url: "/jquerydata.asmx/InsertClosedForm",
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function (response) {
                        if (response.d >= 0) {
                            showMessage('✅ We will contact you shortly or Call us at: 👉 +91 7518147771', 'green');
                            // $form[0].reset();
                            // Redirect to thankspage.aspx
                            window.location.href = 'https://www.clearallexams.in/online-nism-certificate-course-classes/thank-you';

                        } else {
                            showMessage('Submission failed. Please try again.', 'red');
                        }
                    },
                    error: function () {
                        showMessage('Something went wrong. Please try again.', 'red');
                    }
                });
            });

            // 🔹 Helper: Show message
            function showMessage(text, color) {
                $message.css('color', color).text(text);
            }

            // 🔹 Helper: Validate email and phone
            function validateEmailAndPhone(email, phone) {
                return {
                    email: /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email),
                    phone: /^\d{10}$/.test(phone)
                };
            }
        });
    </script>

