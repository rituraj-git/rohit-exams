    <main class="main"> 
        <!-- breadcrumb -->
        <%--<img src="images/Study-Materials-NISM.png" alt=""/> --%>
        <!-- breadcrumb end --> 
        <!-- car area -->
        <hr />
        <div class="car-area list bg py-120">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12" style="overflow-x: auto; white-space: nowrap;">
                          <asp:GridView ID="GridView1" runat="server" CellPadding="3" CssClass="table table-bordered"
                            ForeColor="Black" AutoGenerateColumns="False"
                            BackColor="White" BorderColor="#999999"
                            BorderStyle="Solid" BorderWidth="1px" Width="100%">
                            <AlternatingRowStyle BackColor="#CCCCCC" />
                              <Columns>
                                <asp:TemplateField  HeaderText="Sr.No.">
                                    <HeaderStyle Width="2%" />
                                    <ItemTemplate>
                                         <%#Container.DataItemIndex+1 %>
                                    </ItemTemplate>
                                </asp:TemplateField> 
                                
                              <asp:TemplateField HeaderText=" Date">
                                   <HeaderStyle Width="7%" />
                                  <ItemTemplate>
                                      <%# Eval("Date") %>
                                  </ItemTemplate>
                              </asp:TemplateField>
                               
                                 <asp:TemplateField HeaderText="Paper Name">
                                      <HeaderStyle Width="25%" />
                                    <ItemTemplate>
                                       <%# Eval("TopicName") %>
                                    </ItemTemplate>
                                </asp:TemplateField>  
                                 <asp:TemplateField HeaderText="Total Questions">
                                      <HeaderStyle Width="10%" />
                                    <ItemTemplate>
                                       <%# Eval("TotalQuestions") %>
                                    </ItemTemplate>
                                </asp:TemplateField>  
                                <asp:TemplateField HeaderText="Attempted">
                                     <HeaderStyle Width="10%" />
                                    <ItemTemplate>
                                  <%# Eval("AttemptedQuestions") %>
                                    </ItemTemplate>
                                </asp:TemplateField>
                                <asp:TemplateField HeaderText="Not Attempted">
                                     <HeaderStyle Width="10%" />
                                    <ItemTemplate>
                                     <%# Eval("NotAttempted") %>
                                    </ItemTemplate>
                                </asp:TemplateField>   
                                  <asp:TemplateField HeaderText="Correct Answers">
                                       <HeaderStyle Width="10%" />
                                    <ItemTemplate>
                                    <%# Eval("CorrectAnswers") %>
                                    </ItemTemplate>
                                </asp:TemplateField>    
                                  <asp:TemplateField HeaderText="Incorrect Answers">
                                       <HeaderStyle Width="10%" />
                                    <ItemTemplate>
                                    <%# Eval("IncorrectAnswers") %>
                                    </ItemTemplate>
                                </asp:TemplateField>   

                                 <asp:TemplateField HeaderText="%age">
                                      <HeaderStyle Width="5%" />
                                    <ItemTemplate>
                                    <%# Eval("Percentage","{0:F2}") %>
                                    </ItemTemplate>
                                </asp:TemplateField>   

                            </Columns>
                            <FooterStyle BackColor="#CCCCCC" />
                            <HeaderStyle BackColor="#181a7a" Font-Bold="True" ForeColor="White" />
                            <PagerStyle BackColor="#999999" ForeColor="Black" HorizontalAlign="Center" />
                            <SelectedRowStyle BackColor="#000099" Font-Bold="True" ForeColor="White" />
                            <SortedAscendingCellStyle BackColor="#F1F1F1" />
                            <SortedAscendingHeaderStyle BackColor="#808080" />
                            <SortedDescendingCellStyle BackColor="#CAC9C9" />
                            <SortedDescendingHeaderStyle BackColor="#383838" />
                        </asp:GridView> 
